# 네이버 블로그 아이디 (blog.naver.com/<아이디>)
NAVER_BLOG_ID=sk15y

# 글 생성에 쓰는 Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 선택: 생성에 쓸 모델 (기본 claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# 브라우저 연결 방식
#   auto    : 원격 디버깅 포트가 열린 크롬이 떠 있으면 거기에 붙고, 없으면 스크립트가 크롬을 띄움 (기본)
#   cdp     : 반드시 켜져 있는 크롬에 붙음 (`npm run chrome` 으로 띄운 창)
#   profile : 항상 스크립트가 크롬을 띄움 (.naver-profile 에 세션 저장)
NAVER_BROWSER_MODE=auto

# 켜져 있는 크롬의 원격 디버깅 주소 (`npm run chrome` 이 여는 포트)
CHROME_CDP_URL=http://127.0.0.1:9222

# 선택: 크롬 실행 파일 경로 (자동 탐색이 실패할 때만)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 선택: `npm run chrome` 이 쓰는 전용 프로필 폴더 (기본 .chrome-profile)
# CHROME_PROFILE_DIR=.chrome-profile

# 선택: profile 모드에서 쓸 브라우저. "chrome"이면 PC 에 설치된 크롬, 비우면 Playwright 내장 Chromium
NAVER_BROWSER_CHANNEL=chrome

# 선택: 참고 글을 가져올 때 기본으로 쓸 글 번호 (쉼표 구분)
REFERENCE_LOG_NOS=224418055011,224410409150
